# ----------------------------------------------------- 
# ZATHURA CONFIG - CATPPUCCIN LATTE (CLARO)
# ----------------------------------------------------- 

# Configurações Gerais de Qualidade de Vida
set selection-clipboard clipboard
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100

# ----------------------------------------------------- 
# CORES DA INTERFACE (LATTE)
# ----------------------------------------------------- 
set notification-error-bg       "#d20f39"
set notification-error-fg       "#eff1f5"
set notification-warning-bg     "#df8e1d"
set notification-warning-fg     "#eff1f5"
set notification-bg             "#eff1f5"
set notification-fg             "#4c4f69"

set completion-bg               "#ccd0da"
set completion-fg               "#4c4f69"
set completion-group-bg         "#ccd0da"
set completion-group-fg         "#1e66f5"
set completion-highlight-bg     "#bcc0cc"
set completion-highlight-fg     "#4c4f69"

set index-bg                    "#ccd0da"
set index-fg                    "#4c4f69"
set index-active-bg             "#bcc0cc"
set index-active-fg             "#4c4f69"

set inputbar-bg                 "#eff1f5"
set inputbar-fg                 "#4c4f69"
set statusbar-bg                "#ccd0da"
set statusbar-fg                "#4c4f69"

set highlight-color             "#df8e1d"
set highlight-active-color      "#ea76cb"

set default-bg                  "#eff1f5"
set default-fg                  "#4c4f69"

set render-loading              true
set render-loading-fg           "#eff1f5"
set render-loading-bg           "#4c4f69"

# ----------------------------------------------------- 
# MODO LEITURA (RECOLORIR PDF)
# ----------------------------------------------------- 
# Isso força o PDF a adotar as cores do tema em vez do branco estourado
set recolor-lightcolor          "#eff1f5" 
set recolor-darkcolor           "#4c4f69"
set recolor                     "true"
set recolor-keephue             "true"
