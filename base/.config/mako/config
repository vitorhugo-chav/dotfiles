# --- CONFIGURAÇÕES GERAIS ---
font=JetBrainsMono Nerd Font 12
width=350
height=150
margin=10
padding=15
border-size=2
border-radius=12
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1
format=<b>%s</b>\n%b

# --- CORES BASE ---
# Fundo escuro com leve transparência (combinando com a Waybar)
background-color=#24273ae6
text-color=#cad3f5
# Borda roxa clara (Lavender) combinando com a janela ativa do Hyprland
border-color=#b7bdf8
progress-color=over #313244

# --- COMPORTAMENTO POR URGÊNCIA ---

# Notificações normais (Volume, brilho, etc)
[urgency=low]
border-color=#8aadf4
default-timeout=3000

# Notificações críticas (Bateria quase acabando, erro de sistema)
[urgency=critical]
border-color=#ed8796
background-color=#ed8796
text-color=#24273a
default-timeout=0
